#!/usr/bin/env sh
set -eu

# Run ESLint and check for formatting issues
npx expo lint --max-warnings=0

# Check for large files that shouldn't be committed
LARGE_FILE_LIMIT=5000000  # 5MB in bytes
for file in $(git diff --cached --name-only --diff-filter=ACMR | grep -v '^.git/'); do
    if [ -f "$file" ] && [ "$(wc -c < "$file")" -gt "$LARGE_FILE_LIMIT" ]; then
        echo "✗ File $file is larger than 5MB. Consider using Git LFS or excluding it."
        exit 1
    fi
done

# Check for sensitive files that should not be committed
for sensitive in .env .env.local .env.production; do
    if git diff --cached --name-only | grep -q "^$sensitive$"; then
        echo "✗ Sensitive file $sensitive detected in commit. Add to .gitignore."
        exit 1
    fi
done

# Check for macOS metadata files
if git diff --cached --name-only | grep -qE '\.DS_Store|__MACOSX'; then
    echo "✗ macOS metadata files detected. Please remove them."
    git diff --cached --name-only | grep -E '\.DS_Store|__MACOSX'
    exit 1
fi

echo "✓ All pre-commit checks passed"
